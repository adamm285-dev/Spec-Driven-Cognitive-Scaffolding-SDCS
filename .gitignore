# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
*.whl

# Virtual environments & Local credentials
.env
.env.*
!.env.example
!.env.template
.venv
env/
venv/
ENV/

# Testing, Coverage & Linters
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.coverage
.coverage.*
coverage.xml
*.cover
htmlcov/
.tox/
.nox/
.hypothesis/

# Logs & Diagnostics
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor files
.vscode/
*.code-workspace
.idea/
*.swp
*.swo
*~
*.bak

# OS artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Scratch / Temporary directories & files
scratch/
tmp/
temp/
*.tmp

# SDCS Dynamic Working Memory & Daily Shift Handoffs
# Preserve directory structure and templates, ignore ephemeral daily flight records
sessions/*
!sessions/template.md
!sessions/.gitkeep
.agent/sessions/*
!.agent/sessions/template.md
!.agent/sessions/.gitkeep

# Local launch copy / internal scratch notes
LAUNCH.md

# Large binary multimedia assets (hosted via GitHub Releases)
media/AV/*.mp4
media/AV/*.m4a
media/AV/*.mp3
media/AV/*.wav
