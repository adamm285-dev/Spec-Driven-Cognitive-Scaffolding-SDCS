#!/usr/bin/env bash
# .git/hooks/pre-commit
# SDCS Enforcer: Guarantees working memory and decisions are kept current.
# Supports both Strict Mode (blocking) and Advisory Mode (warning only, zero flow-state friction).

set -e

# --- Configuration ---
# Minimum lines changed in source code to trigger a "major change" check
LINE_THRESHOLD=40

# Enforcement mode: 'strict' (blocks commit) or 'advisory' (prints warning, allows commit)
# Configurable via: git config sdcs.mode advisory|strict
# Or via environment variable: export SDCS_WARN_ONLY=1 or export SDCS_MODE=advisory
CONFIG_MODE=$(git config sdcs.mode 2>/dev/null || echo "strict")
SDCS_MODE="${SDCS_MODE:-$CONFIG_MODE}"
if [ "$SDCS_WARN_ONLY" = "1" ]; then
    SDCS_MODE="advisory"
fi

# Source code extensions to monitor for major logic changes
CODE_EXTENSIONS="\.(py|kt|rs|go|ts|js|jsx|tsx|sol|c|cpp|h)$"

# Candidate paths for SDCS scaffolding files (root or .agent/)
STATE_FILES=("state.md" ".agent/state.md" "STATE.md" ".agent/STATE.md")
DECISION_FILES=("decisions.md" ".agent/decisions.md" "DECISIONS.md" ".agent/DECISIONS.md")
SPINE_FILES=("spine.md" ".agent/spine.md" "SPINE.md" ".agent/SPINE.md" "wiring.yaml" ".agent/wiring.yaml")

# --- Step 1: Detect Staged Files ---
STAGED_FILES=$(git diff --cached --name-only)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# --- Step 2: Check if Scaffolding Files are Staged ---
STATE_STAGED=false
DECISIONS_STAGED=false
SPINE_STAGED=false

for file in $STAGED_FILES; do
    for state_candidate in "${STATE_FILES[@]}"; do
        if [ "$file" == "$state_candidate" ]; then
            STATE_STAGED=true
        fi
    done
    for decision_candidate in "${DECISION_FILES[@]}"; do
        if [ "$file" == "$decision_candidate" ]; then
            DECISIONS_STAGED=true
        fi
    done
    for spine_candidate in "${SPINE_FILES[@]}"; do
        if [ "$file" == "$spine_candidate" ]; then
            SPINE_STAGED=true
        fi
    done
done

# --- Step 3: Calculate Code Diff Velocity ---
TOTAL_CODE_CHANGES=0

while read -r added deleted filepath; do
    # Skip binary files or unmapped rows
    if [ "$added" == "-" ] || [ "$deleted" == "-" ]; then
        continue
    fi

    # Check if the file matches monitored source code extensions
    if echo "$filepath" | grep -Eq "$CODE_EXTENSIONS"; then
        FILE_DELTA=$((added + deleted))
        TOTAL_CODE_CHANGES=$((TOTAL_CODE_CHANGES + FILE_DELTA))
    fi
done < <(git diff --cached --numstat)

# --- Step 4: Evaluate Invariant Gates ---
ERRORS=0

# Gate A: Working Memory Gate (state.md)
# Any code mutation >= LINE_THRESHOLD requires updating the blackboard
if [ "$TOTAL_CODE_CHANGES" -ge "$LINE_THRESHOLD" ] && [ "$STATE_STAGED" = false ]; then
    if [ "$SDCS_MODE" = "advisory" ]; then
        echo "💡 [SDCS Advisory] Major code changes detected ($TOTAL_CODE_CHANGES lines modified)."
        echo "   Reminder: Remember to update state.md before declaring task complete."
        echo ""
    else
        echo "❌ [SDCS Gate Failure] Major code changes detected ($TOTAL_CODE_CHANGES lines modified)."
        echo "   Missing: state.md (or .agent/state.md) is not staged."
        echo "   Action: Update your active objective, verification gates, and edge cases in state.md."
        echo "   Tip: Run 'git config sdcs.mode advisory' if solo coding in flow state."
        echo ""
        ERRORS=$((ERRORS + 1))
    fi
fi

# Gate B: Episodic Memory Gate (decisions.md)
# High-velocity modifications (e.g., > 120 lines) require checking if an ADR was added/updated
ARCH_THRESHOLD=$((LINE_THRESHOLD * 3))
if [ "$TOTAL_CODE_CHANGES" -ge "$ARCH_THRESHOLD" ] && [ "$DECISIONS_STAGED" = false ]; then
    echo "⚠️ [SDCS Warning] High-impact architectural mutation ($TOTAL_CODE_CHANGES lines modified)."
    echo "   Missing: decisions.md (or .agent/decisions.md) was not touched."
    echo "   Rule: Large refactors and multi-module shifts must document tradeoffs to avoid amnesia loops."
    echo ""
fi

# Gate C: Constitutional Invariant Protection Gate (spine.md & wiring.yaml)
# Addresses the "Permission Illusion / Soft Invariant Hole":
# Autonomous agents are forbidden from mutating spine.md or wiring.yaml to bypass failing test gates.
# Human engineers must set SDCS_ALLOW_INVARIANT_MUTATION=1 (or SDCS_ALLOW_CONSTITUTIONAL_MUTATION=1) to edit these files.
if [ "$SPINE_STAGED" = true ] && [ "$SDCS_ALLOW_INVARIANT_MUTATION" != "1" ] && [ "$SDCS_ALLOW_CONSTITUTIONAL_MUTATION" != "1" ]; then
    if [ "$SDCS_MODE" = "advisory" ]; then
        echo "💡 [SDCS Advisory] Constitutional file (spine.md / wiring.yaml) modified in this commit."
        echo "   Ensure this change was authorized by a human, not an autonomous agent bypassing test gates."
        echo ""
    else
        echo "🛑 [SDCS Gate Failure] Constitutional Invariant Protection Gate Triggered!"
        echo "   Detected staged modifications to spine.md or wiring.yaml."
        echo "   Autonomous agents are strictly forbidden from weakening constitutional rules to pass gates."
        echo "   To commit human-authorized edits: export SDCS_ALLOW_INVARIANT_MUTATION=1"
        echo ""
        ERRORS=$((ERRORS + 1))
    fi
fi

# Resolve Python interpreter for static verification gates (Gate T, Gate M)
PYTHON_BIN=""
if [ -n "$VIRTUAL_ENV" ]; then
    if [ -x "$VIRTUAL_ENV/Scripts/python.exe" ]; then
        PYTHON_BIN="$VIRTUAL_ENV/Scripts/python.exe"
    elif [ -x "$VIRTUAL_ENV/bin/python" ]; then
        PYTHON_BIN="$VIRTUAL_ENV/bin/python"
    fi
fi

if [ -z "$PYTHON_BIN" ]; then
    for candidate in python3 python py; do
        if command -v "$candidate" >/dev/null 2>&1; then
            if "$candidate" -c "import sys" >/dev/null 2>&1; then
                PYTHON_BIN="$candidate"
                break
            fi
        fi
    done
fi

# --- Step 3.5: Deterministic Pre-Flight Auto-Repair (sdcs repair) ---
# Executes local formatters (ruff --fix, black, prettier) to fix style/whitespace
# with ZERO LLM inference tokens before kinetic gates evaluate.
if [ -n "$PYTHON_BIN" ] && [ "$SDCS_SKIP_AUTO_REPAIR" != "1" ]; then
    "$PYTHON_BIN" -m sdcs.cli repair --staged >/dev/null 2>&1 || true
fi

# Gate S: Working Memory Token Budget Gate (state.md <= 350 tokens)
# Enforces physical token ceiling on working memory to prevent context bloat
if [ "$STATE_STAGED" = true ]; then
    if [ -z "$PYTHON_BIN" ]; then
        echo "⚠️ [SDCS Warning] No functional Python interpreter found to run Gate S token check."
    else
        echo "[SDCS::GATE_S] Auditing state.md working memory token budget (<= 350 tokens)..."
        if ! "$PYTHON_BIN" -m sdcs.cli verify --state --max-tokens 350; then
            if [ "$SDCS_MODE" = "advisory" ]; then
                echo "💡 [SDCS Advisory] state.md working memory budget exceeded, but running in advisory mode."
                echo ""
            else
                echo "🛑 [SDCS Gate Failure] Gate S: Working Memory Token Budget Exceeded!"
                echo "   state.md exceeds the 350-token budget ceiling or has schema violations."
                echo "   Prune state.md to <= 300 tokens before committing."
                echo ""
                ERRORS=$((ERRORS + 1))
            fi
        fi
    fi
fi

# Gate P: Declarative Sandbox & Protected Paths Gate (wiring.yaml)
# Blocks uncontracted mutations to sensitive secrets (.env, credentials)
if [ "$SDCS_ALLOW_SANDBOX_OVERRIDE" != "1" ]; then
    if [ -n "$PYTHON_BIN" ]; then
        if ! "$PYTHON_BIN" -m sdcs.cli verify --sandbox; then
            if [ "$SDCS_MODE" = "advisory" ]; then
                echo "💡 [SDCS Advisory] Sandbox protected path modification detected (advisory mode)."
                echo ""
            else
                echo "🛑 [SDCS Gate Failure] Gate P: Sandbox Protected Path Mutation Detected!"
                echo "   One or more staged files violate sandbox protected_paths in wiring.yaml."
                echo "   To override: export SDCS_ALLOW_SANDBOX_OVERRIDE=1"
                echo ""
                ERRORS=$((ERRORS + 1))
            fi
        fi
    fi
fi

# Gate T: AST Topology Boundary Audit & Negative Memory Persistence (wiring.yaml)
# Checks codebase AST against declared subsystem boundaries and appends violations to decisions.md
WIRING_EXISTS=false
if [ -f "wiring.yaml" ] || [ -f ".agent/wiring.yaml" ]; then
    WIRING_EXISTS=true
fi

if [ "$WIRING_EXISTS" = true ]; then
    if [ -z "$PYTHON_BIN" ]; then
        echo "⚠️ [SDCS Warning] No functional Python interpreter found to run Gate T verification."
        echo "   Skipping Gate T AST boundary check. Please ensure Python is on PATH."
    else
        echo "[SDCS::GATE_T] Auditing codebase AST against wiring.yaml contracts..."
        if ! "$PYTHON_BIN" -m sdcs.cli verify --topology --append-rejections; then
            if [ "$SDCS_MODE" = "advisory" ]; then
                echo "💡 [SDCS Advisory] Topology boundary violation detected but running in advisory mode."
                echo ""
            else
                echo "🛑 [SDCS Gate Failure] Gate T: Architectural Boundary Violation Detected!"
                echo "   Failure footprint recorded to decisions.md (unstaged)."
                echo ""
                echo "Actions required before re-commit:"
                echo "  1. Review decisions.md to inspect the rejection constraints."
                echo "  2. Refactor code to conform to declared subsystem boundaries."
                echo "  3. Stage your source fixes and updated decisions.md, then re-commit:"
                echo "     git add <source_files> decisions.md && git commit"
                echo ""
                ERRORS=$((ERRORS + 1))
            fi
        fi
    fi
fi

# Gate M: Cartography Drift Audit (app_map.md)
# Prevents cartographic amnesia by verifying all tracked files are indexed in app_map.md
MAP_EXISTS=false
if [ -f "app_map.md" ] || [ -f ".agent/app_map.md" ]; then
    MAP_EXISTS=true
fi

if [ "$MAP_EXISTS" = true ]; then
    if [ -z "$PYTHON_BIN" ]; then
        echo "⚠️ [SDCS Warning] No functional Python interpreter found to run Gate M verification."
        echo "   Skipping Gate M cartography check."
    else
        echo "[SDCS::GATE_M] Auditing repository cartography against app_map.md..."
        if ! "$PYTHON_BIN" -m sdcs.cli map --check; then
            if [ "$SDCS_MODE" = "advisory" ]; then
                echo "💡 [SDCS Advisory] Cartography drift detected but running in advisory mode."
                echo ""
            else
                echo "🛑 [SDCS Gate Failure] Gate M: Cartography Drift Detected!"
                echo "   One or more files on disk are unmapped in app_map.md (or orphaned)."
                echo ""
                echo "Actions required before re-commit:"
                echo "  1. Run cartography sync: 'sdcs map --sync'"
                echo "  2. Stage your updated app_map.md and re-commit:"
                echo "     git add app_map.md && git commit"
                echo ""
                ERRORS=$((ERRORS + 1))
            fi
        fi
    fi
fi


# Gate Cycles: Circuit Breaker Oscillation & Thrashing Audit
if [ -n "$PYTHON_BIN" ]; then
    if ! "$PYTHON_BIN" -m sdcs.cli verify --cycles; then
        if [ "$SDCS_MODE" = "advisory" ]; then
            echo "💡 [SDCS Advisory] Circuit breaker detected file oscillation across recent commits."
            echo ""
        else
            echo "🛑 [SDCS Gate Failure] Circuit Breaker: Cyclic Thrashing Detected!"
            echo "   Repeated file oscillation detected across recent commits without architectural progression."
            echo "   Halted to prevent token exhaustion and repository damage."
            echo ""
            ERRORS=$((ERRORS + 1))
        fi
    fi
fi

# Gate Q: Test Quality & Anti-Mock AST Audit
if [ -n "$PYTHON_BIN" ]; then
    if ! "$PYTHON_BIN" -m sdcs.cli verify --quality; then
        if [ "$SDCS_MODE" = "advisory" ]; then
            echo "💡 [SDCS Advisory] Test quality violations detected but running in advisory mode."
            echo ""
        else
            echo "🛑 [SDCS Gate Failure] Gate Q: Test Quality / Anti-Mocking Violation Detected!"
            echo "   One or more test files contain hollow tests (assert True, assertless, swallowed exceptions, or mock abuse)."
            echo "   Provide substantive assertions before committing."
            echo ""
            ERRORS=$((ERRORS + 1))
        fi
    fi
fi

# Gate E: Toolchain & Environment Invariant Audit
if [ -n "$PYTHON_BIN" ]; then
    if ! "$PYTHON_BIN" -m sdcs.cli verify --env; then
        if [ "$SDCS_MODE" = "advisory" ]; then
            echo "💡 [SDCS Advisory] Environment invariant mismatch detected but running in advisory mode."
            echo ""
        else
            echo "🛑 [SDCS Gate Failure] Gate E: Environment Invariant Mismatch Detected!"
            echo "   Toolchain or runtime environment does not satisfy declared requirements."
            echo "   DO NOT edit application code to circumvent environment errors."
            echo "   Fix your local interpreter, tools, or environment variables."
            echo ""
            ERRORS=$((ERRORS + 1))
        fi
    fi
fi

# Gate C-Cache: KV-Cache Prefix Invariance Audit
if [ -n "$PYTHON_BIN" ]; then
    if ! "$PYTHON_BIN" -m sdcs.cli verify --cache-invariance; then
        if [ "$SDCS_MODE" = "advisory" ]; then
            echo "💡 [SDCS Advisory] Cache-busting volatile prefix detected in templates (advisory mode)."
            echo ""
        else
            echo "🛑 [SDCS Gate Failure] Gate C-Cache: Cache-Busting Volatile Prefix Detected!"
            echo "   Dynamic timestamps, turn counters, or session IDs were found in system instructions."
            echo "   Move volatile state to dynamic state.md tail to preserve KV caching."
            echo ""
            ERRORS=$((ERRORS + 1))
        fi
    fi
fi

# --- Step 5: Exit Evaluation ---

if [ "$ERRORS" -gt 0 ]; then
    echo "Commit rejected by SDCS pre-commit hook."
    echo "To bypass (emergency hotfixes only): git commit --no-verify"
    echo "To switch to advisory mode: git config sdcs.mode advisory"
    exit 1
fi

exit 0
